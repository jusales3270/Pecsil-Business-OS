# Valores públicos usados pelo navegador. Configure no ambiente, nunca no código.
# No Coolify, as NEXT_PUBLIC_* precisam estar marcadas como variável de BUILD.
#
# Produção: o Supabase não é publicado para fora do servidor. O navegador passa
# pelo gateway do próprio Business OS, então a URL pública é o domínio do OS + /sb:
#   NEXT_PUBLIC_SUPABASE_URL=https://<dominio-do-business-os>/sb
# Desenvolvimento local: a URL direta do Supabase (ex.: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Em instalações self-hosted que ainda usam chaves JWT legadas, use esta
# variável no lugar de NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Marque como segredo no ambiente de produção.
SUPABASE_SERVICE_ROLE_KEY=
# Somente servidor. Endereço do Kong do Supabase na rede interna do Docker
# (ex.: http://supabase-kong:8000). É o destino do gateway /sb e o endereço que
# as rotas de API usam. Vazio = usa NEXT_PUBLIC_SUPABASE_URL (dev local).
SUPABASE_INTERNAL_URL=

# Provisionamento inicial, utilizado apenas pelo script administrativo.
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_NAME=

# Vídeo de fundo da tela de login (opcional). URL pública de um CDN/storage
# (Vercel Blob, Supabase Storage, etc.). Vazio = mostra só o gradiente da marca.
NEXT_PUBLIC_LOGIN_VIDEO_URL=

# TypeSafe — decisões tipadas (https://console.typesafe.ai/keys).
# Somente servidor; nunca prefixar com NEXT_PUBLIC_.
TYPESAFE_API_KEY=

# ---------------------------------------------------------------------------
# Comercial (CRM) — leitura das caixas de e-mail pelo Microsoft Graph.
# ---------------------------------------------------------------------------
# Aplicativo registrado no Entra ID (client credentials). Somente servidor;
# nunca prefixar com NEXT_PUBLIC_.
#
# IMPORTANTE: não conceda Mail.Read/Mail.Send no Entra. Permissão consentida lá
# vale para TODAS as caixas da empresa e anula qualquer escopo. As permissões
# entram pelo Exchange Online (RBAC for Applications), com um papel por caixa:
#   comercial@…  → Application Mail.ReadWrite + Application Mail.Send
#   caixa pessoal → Application Mail.ReadBasic  (remetente, assunto e data; sem corpo)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Segredo da rodada de leitura (POST /api/comercial/sync), chamada pela tarefa
# agendada do Coolify por dentro do contêiner. Mínimo 16 caracteres; sem ele a
# rota fica fechada. Gere com: openssl rand -base64 32
MAIL_SYNC_SECRET=
